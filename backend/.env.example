# Application
NODE_ENV=development
PORT=3000
APP_NAME=Azzurro Review Insights API
APP_VERSION=0.1.0
APP_TIMEZONE=Australia/Sydney

# Comma-separated list. Do not use "*" with credentialed requests.
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (matches the root docker-compose.yml development service)
DATABASE_URL=postgresql://azzurro:azzurro_dev_password@localhost:5432/azzurro_reviews?schema=public

# Public review collection. Keep page counts and delays conservative.
SCRAPER_HEADLESS=true
SCRAPER_MAX_PAGES=3
SCRAPER_TIMEOUT_MS=30000
SCRAPER_DELAY_MS=1200
